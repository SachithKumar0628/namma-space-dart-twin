# Frontend Environment Variables
# Copy this file to .env and fill in the values

# API Server URL
VITE_API_BASE=http://localhost:5000

# Reconstruction Service URL (optional, for COLMAP photogrammetry)
VITE_RECONSTRUCTION_API_BASE=http://localhost:8000

# COLMAP SfM compute device: auto (prefer CUDA GPU), cuda (GPU required), cpu
# Runs inside the dart-twin conda environment with an NVIDIA GPU.
VITE_RECONSTRUCTION_SFM_DEVICE=auto

# Google Gemini API Key (optional, for AI features)
VITE_GOOGLE_API_KEY=

# Enable authentication (true/false)
VITE_ENABLE_AUTH=false

# App-level pepper for password hashing (must match server AUTH_SALT)
# Generate: openssl rand -hex 32
VITE_AUTH_SALT=change-me-in-production
