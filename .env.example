# Namma Space — Performance Configuration (RTX 3050 Laptop, 4 GB VRAM)
#
# Copy to .env and adjust as needed. These are the variables read by
# reconstruction_service/config.py at startup.
#
# Load:  set -a; . .env; set +a   (WSL)
#        $env:DOTENV_FILE=".env"; python -m dotenv ...  (Windows)
# Or pass individually:  DART_VRAM_LIMIT_MB=3000 python -m uvicorn ...

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Keep intermediate work directories after a run (useful for debugging).
DART_KEEP_WORK=0
# Per-file upload cap (MB). 0 = unlimited.
DART_MAX_FILE_MB=512
# Total upload cap (MB). 0 = unlimited.
DART_MAX_TOTAL_MB=4096
# Max photos per batch. 0 = unlimited.
DART_MAX_PHOTOS=0

# ---------------------------------------------------------------------------
# Ingestion / preprocessing
# ---------------------------------------------------------------------------
# Max image edge after normalization (px). Lower = faster SfM, less VRAM.
DART_MAX_IMAGE_SIZE=1200
# JPEG quality for re-encoded images.
DART_JPEG_QUALITY=90
# Blur threshold (Laplacian variance). Higher = stricter.
DART_BLUR_THRESHOLD=18.0
# Duplicate detection (dHash Hamming distance). Lower = stricter.
DART_DUPLICATE_HAMMING=6
# Minimum usable images for a viable reconstruction.
DART_MIN_IMAGES=3
DART_MIN_USABLE_IMAGES=3
# Cap on images actually fed to SfM (excess images are subsampled).
DART_MAX_USABLE_IMAGES=80

# ---------------------------------------------------------------------------
# Video
# ---------------------------------------------------------------------------
# Frame extraction interval (seconds).
DART_VIDEO_INTERVAL=1.0
# Max frames extracted from a single video.
DART_VIDEO_MAX_FRAMES=60
# Max video duration to process (seconds).
DART_VIDEO_MAX_SECONDS=120.0

# ---------------------------------------------------------------------------
# SfM (COLMAP / pycolmap, CPU on Windows)
# ---------------------------------------------------------------------------
DART_SFM_ENGINE=pycolmap
DART_SFM_DEVICE=cpu
# Max SIFT features per image.
DART_MAX_FEATURES=8192
# Max matches per image pair.
DART_MAX_MATCHES=65536
# SfM CPU threads.
DART_SFM_THREADS=8
# Minimum registration rate (fraction of images that must register).
DART_MIN_REGISTRATION_RATE=0.34
# Exhaustive matching is used up to this image count; beyond it, sequential.
DART_EXHAUSTIVE_LIMIT=80

# ---------------------------------------------------------------------------
# Dense MVS (COLMAP PatchMatch Stereo + Stereo Fusion)
# ---------------------------------------------------------------------------
# Enable dense MVS (set 0 to skip and save ~2-5 minutes per run).
DART_DENSE_ENABLED=1
# Max image edge for dense MVS (px). 1024 is safe for 4 GB VRAM.
DART_DENSE_MAX_IMAGE_SIZE=1024
# GPU index for dense MVS (0 = only GPU).
DART_DENSE_GPU_INDEX=0
# Dense MVS timeout (seconds).
DART_DENSE_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Mesh (Open3D Poisson + Blender GLB)
# ---------------------------------------------------------------------------
# Target triangle count after decimation.
DART_MESH_TRIANGLES=100000
# Poisson surface reconstruction depth (6-12).
DART_MESH_DEPTH=8

# ---------------------------------------------------------------------------
# Gaussian Splatting (Brush engine)
# ---------------------------------------------------------------------------
# Engine: auto | brush | gsplat
DART_SPLAT_ENGINE=brush
# Training steps (lower = faster, less VRAM; 3000-8000 for testing).
DART_SPLAT_STEPS=4000
# Training image resolution (px). 640 is safe for 4 GB VRAM.
DART_SPLAT_RESOLUTION=640
# Max Gaussian count cap.
DART_SPLAT_MAX=150000
# Training timeout (seconds).
DART_SPLAT_TIMEOUT=1800
# VRAM hard limit (MB). Training aborts if exceeded.
DART_VRAM_LIMIT_MB=3000
# VRAM poll interval (seconds).
DART_VRAM_POLL=1.0

# ---------------------------------------------------------------------------
# External tool locations
# ---------------------------------------------------------------------------
# COLMAP (CUDA build). Default: C:\COLMAP\colmap-x64-windows-cuda\bin\colmap.exe
# COLMAP_BINARY=C:\COLMAP\colmap-x64-windows-cuda\bin\colmap.exe
# Blender. Default: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# BLENDER_BINARY=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Brush. Default: .tools/brush/brush_app.exe
# BRUSH_BINARY=.tools/brush/brush_app.exe
# FFmpeg (on PATH by default).
# FFMPEG_BINARY=ffmpeg
