# Reconstruction Service Environment Variables
# Copy this file to reconstruction_service/.env

# Data directory for jobs and assets
DART_RECONSTRUCTION_DATA=../data/reconstructions

# Maximum photos per job
DART_MAX_PHOTOS=60

# Maximum file size per photo (MB)
DART_MAX_FILE_MB=40

# Maximum total upload size (MB)
DART_MAX_TOTAL_MB=800

# Keep work directories after completion (true/false)
DART_KEEP_WORK=false

# CORS allowed origins (comma-separated or *)
DART_ALLOWED_ORIGINS=*

# Server host and port
DART_RECONSTRUCTION_HOST=127.0.0.1
DART_RECONSTRUCTION_PORT=8000
