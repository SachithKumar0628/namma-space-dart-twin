# Server Environment Variables
# Copy this file to server/.env or set environment variables

# Server port
PORT=5000

# Server host
HOST=127.0.0.1

# Enable authentication (true/false) - defaults to false (demo mode)
# When false, a random demo password is generated on first run and logged to stdout.
ENABLE_AUTH=false

# App-level pepper for password hashing. CHANGE THIS in production—never commit a real value.
# Generate: openssl rand -hex 32
AUTH_SALT=change-me-in-production

# CORS origins (comma-separated). '*' allowed in dev only; do NOT use with credentials in production.
CORS_ORIGINS=http://localhost:3000

# Database path (relative to project root)
DB_PATH=./server.db

# Clean start: wipe persisted DB, reconstruction jobs, and published models on every boot.
# Set to 1 or true so hosting never resumes with previous images/data.
# Use with care—this deletes data/nammatwin.sqlite and data/reconstructions/.
DART_CLEAN_START=1
